{
	"schemaVersion": 1,
	"id": "polarclient",
	"version": "${version}",
	"name": "Polar Client",
	"description": "An all-in-one PvP and quality-of-life client: HUD mods, zoom, freelook, keystrokes, custom crosshair, fullbright and more, with a Right Shift mod menu and drag-and-drop HUD editor.",
	"authors": [
		"Polar Client"
	],
	"contact": {
		"homepage": "https://github.com/PolarClientMC",
		"sources": "https://github.com/PolarClientMC/polar-client"
	},
	"license": "MIT",
	"icon": "assets/polarclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.polarclient.impl.PolarMod"
		]
	},
	"mixins": [
		"polarclient.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
